# Application
APP_NAME=Crevo
APP_ENV=production
APP_URL=https://your-domain.vercel.app
APP_VERSION=1.0.6

# Encryption Key (32-byte base64 or hex key for AES-256-GCM DB encryption & session signing)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# MongoDB (Replica Set recommended for multi-document transactions, e.g. MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/crevoai?retryWrites=true&w=majority

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=crevo-public
R2_PRIVATE_BUCKET=crevo-private
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Cron Security Token (for HTTP-triggered cron endpoints)
CRON_SECRET=

# Pusher Channels Realtime Broadcast
PUSHER_APP_ID=2214440
PUSHER_KEY=174cccbc359655825d01
NEXT_PUBLIC_PUSHER_KEY=174cccbc359655825d01
PUSHER_SECRET=da999b26cb60def62cda
PUSHER_CLUSTER=mt1
NEXT_PUBLIC_PUSHER_CLUSTER=mt1

# Optional Cloudflare for SaaS (Custom Domain SSL Automation)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Optional Sentry Error Reporting Endpoint
APP_SENTRY=https://sentry.titansys.dev

# Optional Demo Mode (only active when APP_DEMO=true AND APP_ENV=local/development)
APP_DEMO=false
APP_DEMO_AI_KEY=
APP_DEMO_PUSHER_APPID=
APP_DEMO_PUSHER_KEY=
APP_DEMO_PUSHER_SECRET=
APP_DEMO_PUSHER_CLUSTER=
APP_DEMO_SMTP_HOST=
APP_DEMO_SMTP_PORT=587
APP_DEMO_SMTP_USERNAME=
APP_DEMO_SMTP_PASSWORD=
APP_DEMO_SMTP_ENCRYPTION=tls
APP_DEMO_SMTP_FROM_ADDRESS=
APP_DEMO_SMTP_FROM_NAME=
APP_DEMO_CODE=

# NOTE: App configurations (Pusher/Reverb, Firebase, OAuth, SMTP, Builders, AI Providers, Domains, etc.)
# are managed dynamically via the Admin Panel (/admin/settings) stored in MongoDB system_settings.
